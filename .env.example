# Copy to .env.local for local development (docker-compose.yml matches these defaults).

# Read directly by the Next.js app.
DATABASE_URL=postgres://everletter:everletter@localhost:5433/everletter_dev

# Read by devops/docker-compose.yml (via --env-file .env.local) to configure
# the postgres container. Keep these in sync with DATABASE_URL above - dotenv
# files don't support variable interpolation, so there's no way to derive one
# from the other automatically.
POSTGRES_USER=everletter
POSTGRES_PASSWORD=everletter
POSTGRES_DB=everletter_dev

# Auth.js - required for `pnpm dev` and `pnpm docker:up:full`, not for
# `pnpm docker:up` (Postgres only - no app process runs, so nothing reads
# this). proxy.ts gates every route through auth(), and Auth.js validates
# this eagerly: leaving it blank doesn't degrade gracefully, it's a real
# HTTP 500 (Auth.js's "MissingSecret" error) the first time anything hits
# /api/auth/signin - confirmed by running `pnpm dev` against a blank value.
# Generate a real value with: npx auth secret
AUTH_SECRET=

# Auth.js callback URL - required for `pnpm dev` and `pnpm docker:up:full`,
# same as AUTH_SECRET above. http://localhost:3000 is correct for local
# `pnpm dev`/`docker:up:full`; a real deployment needs its actual public URL.
AUTH_URL=http://localhost:3000

# Google Cloud Console OAuth 2.0 Web application credentials. Placeholders -
# real values pending Marcy setting up the Google Cloud project. Needed to
# complete a real Google sign-in under `pnpm dev`/`docker:up:full`, but
# (unlike AUTH_SECRET/AUTH_URL above) not validated eagerly - the app process
# itself starts fine with these left as placeholders.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Comma-separated email:role pairs; email matching is case-insensitive.
# Not a database table - just an allowlist gate. See lib/allowlist.ts.
ALLOWED_USERS=owner@example.com:owner,staff@example.com:staff
