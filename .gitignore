# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# devops/migrate/'s own isolated, non-workspace node_modules (built fresh
# inside devops/app.Dockerfile's runner stage - see that file and
# devops/migrate/migrate.mjs's own header for why it's separate)
/devops/migrate/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/testing/

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/outputs/
/work/

# NAS deploy log (written by devops/deploy.sh on the deploy host)
/devops/deploy.txt

# Postgres backups (written by devops/backup.sh on the deploy host) - data,
# not code. BACKUP_DIR resolves to <repo root>/backups, not devops/backups.
/backups/

.secrets
*.tsbuildinfo
data/mailing-proofs/
