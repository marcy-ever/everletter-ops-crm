{
  "name": "everletter-ops-crm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "node --experimental-strip-types --experimental-loader=./tests/ts-extensionless-loader.mjs --test tests/allowlist.test.mjs tests/ids.test.mjs tests/keys.test.mjs tests/mailing-rules.test.mjs tests/plans.test.mjs tests/characters.test.mjs tests/batch-dates.test.mjs tests/spreadsheet-normalize.test.mjs tests/spreadsheet-exceptions.test.mjs tests/build-seed.test.mjs tests/format.test.mjs tests/domain-format.test.mjs tests/build-dataset-from-tables.test.mjs tests/build-overrides-from-tables.test.mjs tests/selectors.test.mjs tests/crm-state-isolation.test.mjs tests/render-snapshots.test.mjs",
    "test:e2e": "node --experimental-strip-types --experimental-loader=./tests/ts-extensionless-loader.mjs --test --test-concurrency=1 tests/build-dataset-from-tables.e2e.test.mjs tests/write-to-tables-transactional.e2e.test.mjs tests/shared-state-get.e2e.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "docker:up": "docker-compose -f devops/docker-compose.yml -p everletter-ops-crm --project-directory . --env-file .env.local up -d",
    "docker:up:full": "docker-compose -f devops/docker-compose.yml -f devops/docker-compose.app.yml -p everletter-ops-crm --project-directory . --env-file .env.local up -d --build",
    "docker:down": "docker-compose -f devops/docker-compose.yml -f devops/docker-compose.app.yml -p everletter-ops-crm --project-directory . --env-file .env.local down"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.20.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
